#!/usr/bin/env python3
"""gp entry point. Windows runs it through bin/gp.cmd, because extensionless scripts do not run from PowerShell."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "engine"))

from gp.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
